{
  "manifest_version": 3,
  "name": "MQTT Notifier",
  "version": "1.1.0",
  "description": "Shows a notification and an (animated) alert window when a matching MQTT message is received.",
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib/mqtt.min.js", "background.js"]
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "notifications",
    "alarms",
    "system.display"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_title": "MQTT Notifier - open settings"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mqtt-notifier@mqtt-notifier.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
